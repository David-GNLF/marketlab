# --- SECRETS et données personnelles : ne JAMAIS committer ---
# notifications.json contient le topic ntfy / le token Telegram / le mot de
# passe SMTP ; providers.json la clé Twelve Data ; le portefeuille et les
# ordres sont des données personnelles.
# NB : « data_local/* » et non « data_local/ » — avec un slash final, git
# n'entre pas dans le dossier et l'exception ci-dessous serait ignorée.
data_local/*
!data_local/.gitkeep
# Le portefeuille PAPIER est versionné : le dépôt est privé, il ne contient
# aucun secret, et GitHub Actions en a besoin pour publier la page
# Portefeuille et cibler les alertes de résultats. Après une opération en
# local (paper.py), committer et pousser pour que le site la reflète.
!data_local/paper_portfolio.json

# --- Environnement et caches ---
.venv/
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.ipynb_checkpoints/

# --- Front ---
front/node_modules/
front/dist/

# --- Site généré (reconstruit par scripts/publier.py) ---
site/

# --- Système ---
.DS_Store
Thumbs.db
*.log
