# --- SECRETS et données personnelles : ne JAMAIS committer ---
# notifications.json contient le topic ntfy / le token Telegram / le mot de
# passe SMTP ; providers.json la clé Twelve Data ; le portefeuille et les
# ordres sont des données personnelles.
# NB : « data_local/* » et non « data_local/ » — avec un slash final, git
# n'entre pas dans le dossier et l'exception ci-dessous serait ignorée.
data_local/*
!data_local/.gitkeep
# Le portefeuille PAPIER est versionné : le dépôt est privé, il ne contient
# aucun secret, et GitHub Actions en a besoin pour publier la page
# Portefeuille et cibler les alertes de résultats. Après une opération en
# local (paper.py), committer et pousser pour que le site la reflète.
!data_local/paper_portfolio.json
# Le journal des décisions est versionné : c'est le TRACK RECORD de l'outil
# (dates, avis, prix — aucun secret) et GitHub Actions doit pouvoir l'enrichir
# chaque jour puis le committer.
!data_local/journal_decisions.csv
# Les pondérations apprises du bilan réel : dérivées du journal, committées
# par le workflow pour persister d'un runner à l'autre.
!data_local/poids_appris.json
# Le journal des alertes est le TRIBUNAL des règles d'alerte : il dit
# lesquelles ont crié pour rien. Écrit sur un runner éphémère et jamais
# conservé, il repartait de zéro à chaque passage — « aucune alerte
# journalisée » devenait indiscernable de « le scanner n'a rien envoyé »,
# et une règle bruyante ne pouvait jamais être démasquée.
!data_local/journal_alertes.csv
!data_local/calibration.json
# La volatilité réalisée est versionnée : une ligne par titre et par jour, sans
# secret. Yahoo ne sert les barres 5 min que sur 60 jours glissants, donc
# l'historique ne peut se constituer QUE par un relevé quotidien conservé.
# Les barres brutes, elles, restent dans .cache/ (volumineuses, régénérables).
!data_local/volatilite_realisee.csv
# Verdict de l'arbitrage HAR-RV vs EWMA vs marche au hasard, et coefficients
# du modèle s'il a été retenu. Même logique que poids_appris.json : dérivé des
# données, commité pour persister d'un runner à l'autre.
!data_local/har_modele.json
# Le modele HAR-sur-GKYZ (horizon du cone) : retenu sur les deux
# criteres et 5 ans d'OHLC, il pilote har.vol_cible. Commite pour
# persister d'un runner a l'autre — sans lui, le cone redeviendrait
# inconditionnel a chaque execution.
!data_local/har_gkyz.json
# Verdict par regime : dans quels marches l'avis directionnel est
# suspendu. Derive du journal, commite pour persister d'un runner a
# l'autre — sans lui, le veto serait desarme a chaque execution.
!data_local/regimes_verdict.json
# Spread effectif MESURE (estimateur de Roll) par titre et par seance :
# la table de couts.py devient le repli, plus la verite. Meme logique
# d'accumulation immuable que la volatilite realisee.
!data_local/spreads_mesures.csv
# Part de saut par seance (variation bipower) : la fraction de la
# volatilite qui TRAVERSE les stops au lieu de passer par tous les
# prix. Meme accumulation immuable, memes barres.
!data_local/sauts_mesures.csv
# Instantanes quotidiens des chaines d'options (IV a la monnaie, skew) :
# les chaines sont ephemeres, seul un releve conserve permet de juger
# plus tard nos previsions contre celle du marche.
!data_local/vol_implicite.csv
# Historique du calendrier économique. ForexFactory ne sert QUE la semaine en
# cours : sans accumulation conservée, on ne pourra jamais reconstituer les
# résultats publiés (chaînage par la valeur « précédente » de la publication
# suivante), donc jamais mesurer une surprise. Aucun secret, quelques Ko/mois.
!data_local/calendrier_historique.csv

# --- Environnement et caches ---
.venv/
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.ipynb_checkpoints/

# --- Front ---
front/node_modules/
front/dist/

# --- Site généré (reconstruit par scripts/publier.py) ---
site/

# --- Système ---
.DS_Store
Thumbs.db
*.log
