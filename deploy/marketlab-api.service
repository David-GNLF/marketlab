[Unit]
Description=MarketLab — API FastAPI et interface web
After=network.target

[Service]
Type=simple
User=marketlab
Group=marketlab
WorkingDirectory=/opt/marketlab
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONUTF8=1"
ExecStart=/opt/marketlab/.venv/bin/python -m uvicorn main:app \
    --app-dir /opt/marketlab/api --host 127.0.0.1 --port 8600
Restart=on-failure
RestartSec=10

# --- Protection de l'hôte -------------------------------------------------
# La machine héberge DigiClinic en production avec peu de RAM : MarketLab est
# strictement plafonné pour ne jamais pouvoir l'affamer. En cas de dépassement,
# c'est MarketLab qui est tué, jamais l'application de santé.
MemoryMax=550M
MemoryHigh=450M
CPUQuota=60%
OOMScoreAdjust=800

# --- Durcissement ---------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/marketlab/data_local /opt/marketlab/.cache
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
