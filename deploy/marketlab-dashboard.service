[Unit]
Description=MarketLab — dashboard Streamlit
After=network.target

[Service]
Type=simple
User=marketlab
Group=marketlab
WorkingDirectory=/opt/marketlab
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONUTF8=1"
ExecStart=/opt/marketlab/.venv/bin/python -m streamlit run \
    /opt/marketlab/app/dashboard.py \
    --server.address 127.0.0.1 --server.port 8501 \
    --server.headless true --browser.gatherUsageStats false
Restart=on-failure
RestartSec=10

# Voir marketlab-api.service : plafonds destinés à protéger DigiClinic.
MemoryMax=650M
MemoryHigh=520M
CPUQuota=60%
OOMScoreAdjust=800

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/marketlab/data_local /opt/marketlab/.cache
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
