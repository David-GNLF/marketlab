# Les fichiers destinés au serveur Linux doivent garder des fins de ligne LF :
# un script shell en CRLF échoue avec « bad interpreter », et un fichier
# systemd en CRLF est mal interprété.
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.py        text eol=lf

# Fichiers spécifiques à Windows
*.cmd       text eol=crlf
*.ps1       text eol=crlf
